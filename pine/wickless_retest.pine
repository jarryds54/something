//@version=6
// Wickless-candle retest - XAUUSD 5-minute
//
// Mirrors the Python backtest in this repository (src/engine.py). The rules:
//   1. In a trend, find a candle with no wick on the trend side
//      (uptrend: a bullish candle whose low equals its open).
//   2. Mark that open as a level.
//   3. If price returns to the level within the next few candles, enter with the trend.
//   4. Stop beyond the most recent swing against the position, target at 1:1.
//   5. Only when volatility is above its recent median, and stop for the day after -2R.
//
// Defaults are the configuration that tested best for a FundingPips 2-Step Pro
// evaluation: 94.3% simulated pass rate at 0.5% risk with the daily stop.

strategy("Wickless Retest - XAUUSD 5m", overlay = true,
     initial_capital       = 100000,
     default_qty_type      = strategy.fixed,
     pyramiding            = 0,
     calc_on_every_tick    = false,
     process_orders_on_close = false,
     commission_type       = strategy.commission.cash_per_contract,
     commission_value      = 0.035,   // $7 per 100oz lot, charged per side
     // Gold positions sized to risk 0.5% carry a notional several times the
     // account. Pine defaults to 100% margin (no leverage) and silently refuses
     // those orders, which swallowed ~86% of the trades. 1% = 100:1, the
     // leverage a prop account actually gives you.
     margin_long           = 1.0,
     margin_short          = 1.0,
     max_labels_count      = 500,
     max_boxes_count       = 500,
     max_lines_count       = 500)

// --- inputs ----------------------------------------------------------------
grpS = "Signal"
trendMode   = input.string("displacement", "How to judge the trend",
     options = ["displacement", "structure"], group = grpS,
     tooltip = "displacement: price has travelled more than N ATR over the lookback - what the backtest used. structure: higher highs and higher lows, which reads more like a chart but trades slightly differently.")
trendLen    = input.int(10,   "Trend lookback (bars)",        group = grpS, minval = 2)
trendThresh = input.float(1.0,"Trend strength (x ATR)",       group = grpS, step = 0.1)
trendER     = input.float(0.0,"Minimum cleanliness (0-1)",    group = grpS, step = 0.05, minval = 0, maxval = 1,
     tooltip = "Efficiency ratio: net distance divided by the path travelled. 1 is a straight line, near 0 is chop. Raising it makes the trend filter match the eye better, but it tested WORSE on the most recent period - leave at 0 unless you are experimenting.")
wickTol     = input.float(0.0,"Wick tolerance ($)",           group = grpS, step = 0.001,
     tooltip = "Set this to ONE TICK of the chart you are on. The testing used a feed quoted to 2 decimals, where 'no wick' means the wick is under $0.01. On a feed quoting 3 decimals, 0.0 is a stricter rule than was tested and will find far fewer setups - use 0.01 there to match.")
waitBars    = input.int(7,    "Candles to wait for the retest", group = grpS, minval = 1)

grpV = "Filters"
useVolFilter = input.bool(true, "Only trade above-median volatility", group = grpV)
volPct       = input.float(0.40,"Minimum ATR percentile",            group = grpV, minval = 0, maxval = 1, step = 0.05)
volWindow    = input.int(500,   "Percentile window (bars)",          group = grpV, minval = 200,
     tooltip = "No trades are taken until this many bars have loaded, so a long window wastes chart history. 500 tested the same as 2000.")

grpE = "Stop and target"
pivotK      = input.int(2,    "Swing definition (bars either side)", group = grpE, minval = 1)
stopLookback= input.int(20,   "Search this many bars for the swing", group = grpE, minval = 2)
bufferAtr   = input.float(0.0,"Extra room beyond the swing (x ATR)", group = grpE, step = 0.05)
minStop     = input.float(5.0,"Minimum stop ($)",                    group = grpE, step = 0.5,
     tooltip = "Skips setups whose stop is too tight to be worth trading. A 55c stop builds a 900-ounce position that commission alone ruins. $5 removes the smallest quarter of setups and tested positive in all three periods; stricter than that only looked good in-sample.")
maxStopAtr  = input.float(10.0,"Maximum stop (x ATR)",               group = grpE, step = 0.5)
rr          = input.float(1.0,"Target (x risk)",                     group = grpE, step = 0.25)
useTrail    = input.bool(false,"Trail instead of a fixed target",    group = grpE,
     tooltip = "The higher-earning variant: trails 2x ATR once 2.5R is open. Earns more per trade but passes evaluations far less often.")
trailMult   = input.float(2.0,"Trail distance (x ATR)",              group = grpE, step = 0.25)
trailStartR = input.float(2.5,"Start trailing after (R)",            group = grpE, step = 0.25)

grpR = "Risk"
riskPct     = input.float(0.5,"Risk per trade (% of equity)",        group = grpR, step = 0.05)
dailyStopR  = input.float(2.0,"Stop for the day after losing (R)",   group = grpR, step = 0.5,
     tooltip = "0 disables. This is what keeps the worst day inside a 3% daily limit.")
tzOffset    = input.int(3,    "Broker hours ahead of UTC",           group = grpR,
     tooltip = "FundingPips platform time is UTC+3; the daily limit resets at its midnight.")

grpD = "Display"
showLevels  = input.bool(true, "Draw levels", group = grpD)
showSignals = input.bool(true, "Mark wickless candles", group = grpD)
showTrades  = input.bool(true, "Draw entry, stop and target", group = grpD)
showR       = input.bool(true, "Label each trade's result in R", group = grpD)
showWhy     = input.bool(false, "Explain skipped setups", group = grpD,
     tooltip = "Labels every wickless candle the trend filter rejected, and every level that was touched but not traded, with the reason. Noisy - turn it on to investigate, then off again.")

// --- indicators ------------------------------------------------------------
atr = ta.atr(14)

// trend, two ways
move = close - close[trendLen]
// efficiency ratio: how direct was the journey? 1 is a straight line
path  = math.sum(math.abs(close - close[1]), trendLen)
er    = path > 0 ? math.abs(move) / path : 0.0
erOk  = trendER <= 0 or er >= trendER

half    = math.max(2, math.floor(trendLen / 2))
recentH = ta.highest(high, half)
recentL = ta.lowest(low, half)
priorH  = ta.highest(high, trendLen - half)[half]
priorL  = ta.lowest(low, trendLen - half)[half]

upDisp  = move >  trendThresh * atr
dnDisp  = move < -trendThresh * atr
upStruc = recentH > priorH and recentL > priorL
dnStruc = recentH < priorH and recentL < priorL

upTrend = bar_index > trendLen and erOk and (trendMode == "displacement" ? upDisp : upStruc)
dnTrend = bar_index > trendLen and erOk and (trendMode == "displacement" ? dnDisp : dnStruc)

// volatility regime, judged against the recent past only (shifted by one bar)
atrRank = ta.percentrank(atr, volWindow)[1] / 100.0
volOk   = not useVolFilter or (not na(atrRank) and atrRank >= volPct)

// a candle with no wick on the trend side
bullWickless = close > open and (open - low)  <= wickTol
bearWickless = close < open and (high - open) <= wickTol

// most recent confirmed swing, and the bar it formed on
pivLo = ta.pivotlow(low, pivotK, pivotK)
pivHi = ta.pivothigh(high, pivotK, pivotK)
var float lastPivLo    = na
var int   lastPivLoBar = na
var float lastPivHi    = na
var int   lastPivHiBar = na
if not na(pivLo)
    lastPivLo    := pivLo
    lastPivLoBar := bar_index - pivotK
if not na(pivHi)
    lastPivHi    := pivHi
    lastPivHiBar := bar_index - pivotK

// --- daily loss tracking (broker time, not exchange time) ------------------
dayId   = math.floor((time + tzOffset * 3600000) / 86400000)
newDay  = ta.change(dayId) != 0
var float dayR       = 0.0
var int   lastClosed = 0
// risk in dollars for each pending order, so the trade that fills is matched to
// its own risk rather than whichever order happened to be placed last
var map<string, float> riskById = map.new<string, float>()
var map<string, float> stopById  = map.new<string, float>()
var map<string, float> levelById = map.new<string, float>()
var float curRisk    = na       // risk of the position currently open
var string curId     = na

if newDay
    dayR := 0.0

// a position just opened: find which order filled, and remember its risk
var float justFilledAt = na
var int   justFilledDir = 0
var float curStop  = na
var float curTgt   = na
var float curEntry = na     // kept for drawing; justFilledAt is cleared further down
var int   curDir   = 0
if strategy.position_size != 0 and nz(strategy.position_size[1], 0) == 0
    if strategy.opentrades > 0
        filled  = strategy.opentrades.entry_id(0)
        entryPx = strategy.opentrades.entry_price(0)
        dirNow  = strategy.position_size > 0 ? 1 : -1
        curId   := filled
        // Risk is the distance from the REAL fill to the stop. Measuring it from
        // the level instead silently changes the reward-to-risk ratio whenever a
        // limit order fills better than the level it was resting on.
        curStop := map.contains(stopById, filled) ? map.get(stopById, filled) : na
        curRisk := na(curStop) ? na : (entryPx - curStop) * dirNow
        curTgt  := na(curRisk) ? na : entryPx + rr * curRisk * dirNow
        map.put(riskById, filled, nz(curRisk, 1.0))
        justFilledAt  := entryPx
        justFilledDir := dirNow
        curEntry      := entryPx
        curDir        := dirNow
        // replace the protective stop with the correct stop-and-target pair
        if not na(curRisk) and curRisk > 0
            strategy.exit(filled + "x", from_entry = filled, stop = curStop,
                 limit = useTrail ? na : curTgt)

// bank the R of anything that closed since the previous bar, looking each trade's
// risk up by the entry it came from - a trade that opened and closed inside one
// bar never updates curRisk, so that cannot be relied on here
var float closedLevel = na
var int   closedDir   = 0
if strategy.closedtrades > lastClosed
    for i = lastClosed to strategy.closedtrades - 1
        eid  = strategy.closedtrades.entry_id(i)
        rsk  = map.contains(riskById, eid) ? map.get(riskById, eid) : na
        if not na(rsk) and rsk > 0
            dayR += strategy.closedtrades.profit(i) / rsk
        if map.contains(levelById, eid)
            closedLevel := map.get(levelById, eid)
            closedDir   := str.startswith(eid, "L") ? 1 : -1
    lastClosed := strategy.closedtrades

dayBlocked = dailyStopR > 0 and dayR <= -dailyStopR

// --- pending levels --------------------------------------------------------
var array<float> lvlPrice = array.new_float()
var array<int>   lvlDir   = array.new_int()
var array<int>   lvlBar   = array.new_int()

// a level that has been traded is finished, exactly as in the Python engine.
// Matched by price rather than by index, because the array shifts as levels expire.
usedAt  = na(justFilledAt) ? closedLevel : justFilledAt
usedDir = na(justFilledAt) ? closedDir : justFilledDir
if not na(usedAt) and array.size(lvlPrice) > 0
    for i = array.size(lvlPrice) - 1 to 0
        samePrice = math.abs(array.get(lvlPrice, i) - usedAt) <= syminfo.mintick * 2
        if array.get(lvlDir, i) == usedDir and samePrice
            array.remove(lvlPrice, i)
            array.remove(lvlDir,   i)
            array.remove(lvlBar,   i)
justFilledAt  := na
justFilledDir := 0
closedLevel   := na
closedDir     := 0

// drop levels that have waited too long
if array.size(lvlPrice) > 0
    for i = array.size(lvlPrice) - 1 to 0
        if bar_index - array.get(lvlBar, i) > waitBars
            array.remove(lvlPrice, i)
            array.remove(lvlDir,   i)
            array.remove(lvlBar,   i)

// --- orders ----------------------------------------------------------------
// Each bar: cancel outstanding entries and re-issue them, because the stop
// reference is recalculated from the bars available now - exactly as the Python
// engine computes it from bars strictly before entry.
for i = 0 to 9
    strategy.cancel("L" + str.tostring(i))
    strategy.cancel("S" + str.tostring(i))

canTrade = strategy.position_size == 0 and not dayBlocked and volOk

if canTrade and array.size(lvlPrice) > 0
    count = math.min(array.size(lvlPrice), 10)
    for i = 0 to count - 1
        lv  = array.get(lvlPrice, i)
        dir = array.get(lvlDir, i)
        id  = (dir == 1 ? "L" : "S") + str.tostring(i)

        // structural stop: the most recent swing, if it is recent enough
        ref     = dir == 1 ? lastPivLo : lastPivHi
        refBar  = dir == 1 ? lastPivLoBar : lastPivHiBar
        usable  = not na(ref) and not na(refBar) and (bar_index - refBar) <= stopLookback

        if usable
            stopPx = dir == 1 ? ref - bufferAtr * atr : ref + bufferAtr * atr
            risk   = (lv - stopPx) * dir
            if risk >= minStop and risk <= maxStopAtr * atr
                qty = math.max(1, math.floor(strategy.equity * (riskPct / 100.0) / risk))
                map.put(riskById, id, risk)
                map.put(stopById, id, stopPx)
                map.put(levelById, id, lv)
                strategy.entry(id, dir == 1 ? strategy.long : strategy.short,
                     qty = qty, limit = lv)
                // A provisional target measured from the level, so a trade that
                // reaches its target on the entry candle still exits there. It is
                // corrected to the real fill price as soon as the order fills;
                // when the fill is at the level, the two are identical anyway.
                strategy.exit(id + "x", from_entry = id, stop = stopPx,
                     limit = useTrail ? na : lv + rr * risk * dir)

// --- trailing variant ------------------------------------------------------
if useTrail and strategy.position_size != 0 and not na(curRisk) and not na(curId)
    dir     = strategy.position_size > 0 ? 1 : -1
    entryPx = strategy.position_avg_price
    openR   = ((dir == 1 ? high : low) - entryPx) * dir / curRisk
    if openR >= trailStartR
        trailPx = dir == 1 ? high - trailMult * atr : low + trailMult * atr
        // same id as the original exit, so this replaces it rather than adding to it
        strategy.exit(curId + "x", from_entry = curId, stop = trailPx)

// --- why was a setup skipped? ---------------------------------------------
if showWhy
    // wickless candles that never became levels because of the trend filter
    if bullWickless and not upTrend
        label.new(bar_index, low, "no uptrend", yloc = yloc.belowbar,
             style = label.style_label_up, color = color.new(color.gray, 55),
             textcolor = color.white, size = size.tiny)
    if bearWickless and not dnTrend
        label.new(bar_index, high, "no downtrend", yloc = yloc.abovebar,
             style = label.style_label_down, color = color.new(color.gray, 55),
             textcolor = color.white, size = size.tiny)

    // levels price came back to, that still produced no trade
    if array.size(lvlPrice) > 0
        for i = 0 to array.size(lvlPrice) - 1
            lvW  = array.get(lvlPrice, i)
            dirW = array.get(lvlDir, i)
            if bar_index > array.get(lvlBar, i)
                touched = dirW == 1 ? low <= lvW : high >= lvW
                if touched
                    reason = ""
                    if strategy.position_size != 0
                        reason := "already in a trade"
                    else if dayBlocked
                        reason := "day stopped at -2R"
                    else if not volOk
                        reason := "quiet market (" + str.tostring(nz(atrRank, 0) * 100, "#") + "th pct)"
                    else
                        refW    = dirW == 1 ? lastPivLo : lastPivHi
                        refBarW = dirW == 1 ? lastPivLoBar : lastPivHiBar
                        if na(refW) or na(refBarW) or (bar_index - refBarW) > stopLookback
                            reason := "no recent swing for the stop"
                        else
                            stopW = dirW == 1 ? refW - bufferAtr * atr : refW + bufferAtr * atr
                            riskW = (lvW - stopW) * dirW
                            if riskW < minStop
                                reason := "stop only $" + str.tostring(riskW, "#.##")
                            else if riskW > maxStopAtr * atr
                                reason := "stop too wide ($" + str.tostring(riskW, "#.#") + ")"
                    if reason != ""
                        label.new(bar_index, lvW, reason, style = label.style_label_left,
                             color = color.new(color.orange, 45), textcolor = color.white,
                             size = size.tiny)

// --- record new levels (after orders, so a level cannot trade on its own bar) ---
if upTrend and bullWickless
    array.push(lvlPrice, open)
    array.push(lvlDir, 1)
    array.push(lvlBar, bar_index)
if dnTrend and bearWickless
    array.push(lvlPrice, open)
    array.push(lvlDir, -1)
    array.push(lvlBar, bar_index)

// --- drawing ---------------------------------------------------------------
plotshape(showSignals and upTrend and bullWickless, "wickless up", shape.triangleup,
     location.belowbar, color.new(color.teal, 0), size = size.tiny)
plotshape(showSignals and dnTrend and bearWickless, "wickless down", shape.triangledown,
     location.abovebar, color.new(color.orange, 0), size = size.tiny)

if showLevels and upTrend and bullWickless
    line.new(bar_index, open, bar_index + waitBars, open,
         color = color.new(color.teal, 40), width = 1)
if showLevels and dnTrend and bearWickless
    line.new(bar_index, open, bar_index + waitBars, open,
         color = color.new(color.orange, 40), width = 1)

// --- draw the live trade ---------------------------------------------------
var box  tpBox     = na
var box  slBox     = na
var line entryLine = na

inPosition = strategy.position_size != 0
justOpened = inPosition and nz(strategy.position_size[1], 0) == 0
justClosed = not inPosition and nz(strategy.position_size[1], 0) != 0

if showTrades and justOpened and not na(curStop) and not na(curEntry)
    tgtPx   = nz(curTgt, curEntry)
    top     = curDir == 1 ? tgtPx : curEntry
    bottom  = curDir == 1 ? curEntry : tgtPx
    sTop    = curDir == 1 ? curEntry : curStop
    sBottom = curDir == 1 ? curStop : curEntry
    tpBox := box.new(bar_index, top, bar_index + 1, bottom,
         border_color = color.new(color.teal, 60), bgcolor = color.new(color.teal, 88))
    slBox := box.new(bar_index, sTop, bar_index + 1, sBottom,
         border_color = color.new(color.red, 60), bgcolor = color.new(color.red, 88))
    entryLine := line.new(bar_index, curEntry, bar_index + 1, curEntry,
         color = color.new(color.white, 20), width = 1)

// stretch the boxes along as the trade runs
if showTrades and inPosition and not na(tpBox)
    box.set_right(tpBox, bar_index + 1)
    box.set_right(slBox, bar_index + 1)
    line.set_x2(entryLine, bar_index + 1)

if showR and justClosed and strategy.closedtrades > 0
    idx   = strategy.closedtrades - 1
    eid2  = strategy.closedtrades.entry_id(idx)
    rsk   = map.contains(riskById, eid2) ? map.get(riskById, eid2) : na
    sz    = strategy.closedtrades.size(idx)
    denom = na(rsk) ? na : rsk * math.abs(sz)
    rMult = na(denom) or denom <= 0 ? na : strategy.closedtrades.profit(idx) / denom
    if not na(rMult)
        label.new(bar_index, close, str.tostring(rMult, "#.##") + "R",
             style = rMult > 0 ? label.style_label_down : label.style_label_up,
             color = rMult > 0 ? color.new(color.teal, 30) : color.new(color.red, 30),
             textcolor = color.white, size = size.tiny)

bgcolor(dayBlocked ? color.new(color.red, 92) : na, title = "day stopped out")

// --- on-chart summary ------------------------------------------------------
var table info = table.new(position.top_right, 2, 5, frame_width = 0)
if barstate.islast
    wins = strategy.wintrades
    tot  = strategy.closedtrades
    table.cell(info, 0, 0, "trades",    text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 0, str.tostring(tot), text_size = size.small)
    table.cell(info, 0, 1, "win rate",  text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 1, tot > 0 ? str.tostring(wins / tot * 100, "#.0") + "%" : "-",
         text_size = size.small)
    table.cell(info, 0, 2, "net",       text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 2, str.tostring(strategy.netprofit, "#"), text_size = size.small)
    table.cell(info, 0, 3, "day R",     text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 3, str.tostring(dayR, "#.##"), text_size = size.small)
    table.cell(info, 0, 4, "vol pct",   text_color = color.gray, text_size = size.small)
    table.cell(info, 1, 4, na(atrRank) ? "-" : str.tostring(atrRank * 100, "#") + "%",
         text_size = size.small)
